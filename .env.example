# Data directories
HERMES_DATA_DIR=/tmp/hermes_report
HERMES_REPORT_DIR=/home/ubuntu/.hermes/cron
HERMES_IMAGE_DIR=/home/ubuntu/.hermes/cron/images
HERMES_SCRIPT_DIR=/tmp/ai-art-tools/scripts
HERMES_BASE_URL=http://150.230.56.153:8002

# Pixiv
# A pixiv_token.json file must exist under /home/ubuntu/.hermes/references/ with {"refresh_token": "..."}
# PIXIV_TOKEN_FILE=/home/ubuntu/.hermes/references/pixiv_token.json

# PixAI
# PIXAI_STATE_FILE=/home/ubuntu/.hermes/references/pixai_state.json
PIXAI_EMAIL=
PIXAI_PASSWORD=

# SeaArt (Playwright DOM scrape)
# SEAART_STATE_FILE=/home/ubuntu/.hermes/references/seaart_state.json
# No stable public API exists. Uses Playwright to scrape seaart.ai/post.
# Attempts to open the Filter UI (Hot/Week) and fall back to default feed if unavailable.
SEAART_SORT=hot
SEAART_PERIOD=week
SEAART_POOL_SIZE=20

# CivitAI (optional)
CIVITAI_HYDRATE_STATS=auto
CIVITAI_MAX_HYDRATE=20
CIVITAI_API_TOKEN=

# HuggingFace (optional)
# HF_TOKEN=

# Pipeline
HERMES_SOURCE_TIMEOUT=120
